@keyframes rt-fade-in { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes rt-fade-out { 
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes rt-slide-from-top { 
  0% { transform: translateY(4px) scale(0.97); }
  100% { transform: translateY(0px) scale(1); }
}

@keyframes rt-slide-to-top { 
  0% { transform: translateY(0px) scale(1); }
  100% { transform: translateY(4px) scale(0.97); }
}

@keyframes rt-slide-from-bottom { 
  0% { transform: translateY(-4px) scale(0.97); }
  100% { transform: translateY(0px) scale(1); }
}

@keyframes rt-slide-to-bottom { 
  0% { transform: translateY(0px) scale(1); }
  100% { transform: translateY(-4px) scale(0.97); }
}

@keyframes rt-slide-from-left { 
  0% { transform: translate(4px) scale(0.97); }
  100% { transform: translate(0px) scale(1); }
}

@keyframes rt-slide-to-left { 
  0% { transform: translate(0px) scale(1); }
  100% { transform: translate(4px) scale(0.97); }
}

@keyframes rt-slide-from-right { 
  0% { transform: translate(-4px) scale(0.97); }
  100% { transform: translate(0px) scale(1); }
}

@keyframes rt-slide-to-right { 
  0% { transform: translate(0px) scale(1); }
  100% { transform: translate(-4px) scale(0.97); }
}

