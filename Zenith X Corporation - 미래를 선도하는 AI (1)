@charset "utf-8";

:root { --primary-color: #00dcff; --secondary-color: #9600ff; --background-color: #0a0a1a; --text-color: #e0e0e0; --text-darker: #a0a0a0; --accent-color: #ffffff; --font-main: 'Noto Sans KR', sans-serif; --font-heading: 'Orbitron', sans-serif; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: var(--font-main); background-color: var(--background-color); color: var(--text-color); line-height: 1.6; overflow-x: hidden; }

@keyframes move-twink-back { 
  0% { background-position: 0px 0px; }
  100% { background-position: -10000px 5000px; }
}

@keyframes move-clouds-back { 
  0% { background-position: 0px 0px; }
  100% { background-position: 10000px 0px; }
}

.stars, .twinkling, .clouds { position: absolute; inset: 0px; width: 100%; height: 100%; display: block; z-index: -2; }

.stars { background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAGQAAABkAQMAAABKLAcXAAAABlBMVEUAAAC/v79oKGkkAAAAAXRSTlMAQObYZgAAACRJREFUOMtjYBgFo4AEYAJCAMYfNixCcBQYk4UqDAkBbH4PACQvAxPUWqHKAAAAAElFTkSuQmCC") center top repeat rgb(10, 10, 26); z-index: -3; }

.twinkling { background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAGQAAABkAQMAAABKLAcXAAAABlBMVEUAAAC/v79oKGkkAAAAAnRSTlMAAQGU/a4AAAAiSURBVDjLY2BgYGBkYGBgZGBkZGRkYGBkYGBkZGRkYGBkYGBkAAAGgAABA5QqrwAAAABJRU5ErkJggg==") center top repeat transparent; z-index: -2; animation: 200s linear 0s infinite normal none running move-twink-back; }

.clouds { background: url("data:image/png;base64,") center top repeat transparent; z-index: -1; animation: 200s linear 0s infinite normal none running move-clouds-back; opacity: 0.3; }

.container { max-width: 1200px; margin: 0px auto; padding: 0px 20px; }

header { background-color: rgba(10, 10, 26, 0.8); padding: 1rem 0px; position: fixed; width: 100%; top: 0px; z-index: 1000; backdrop-filter: blur(5px); border-bottom: 1px solid rgba(0, 220, 255, 0.2); }

header .container { display: flex; justify-content: space-between; align-items: center; }

.logo { font-family: var(--font-heading); font-size: 1.8rem; font-weight: 700; color: var(--accent-color); text-shadow: 0 0 5px var(--primary-color); }

nav ul { list-style: none; display: flex; }

nav ul li { margin-left: 2rem; }

nav ul li a { color: var(--text-color); text-decoration: none; font-size: 1rem; transition: color 0.3s, text-shadow 0.3s; }

nav ul li a:hover, nav ul li a:focus { color: var(--primary-color); text-shadow: 0 0 8px var(--primary-color); }

main { padding-top: 80px; }

section { padding: 6rem 0px; position: relative; }

section:nth-child(2n+1) { }

#hero { display: flex; align-items: center; justify-content: center; text-align: center; min-height: calc(-80px + 100vh); position: relative; overflow: hidden; }

#hero .container { position: relative; z-index: 2; }

#hero h1 { font-family: var(--font-heading); font-size: 3.5rem; margin-bottom: 1rem; color: var(--accent-color); text-shadow: 0 0 10px var(--primary-color), 0 0 20px var(--secondary-color); min-height: 90px; }

#hero p { font-size: 1.2rem; margin-bottom: 2rem; color: var(--text-darker); max-width: 600px; margin-left: auto; margin-right: auto; }

.cta-button { display: inline-block; background: linear-gradient(90deg, var(--primary-color), var(--secondary-color)); color: rgb(255, 255, 255); padding: 12px 30px; border-radius: 5px; text-decoration: none; font-weight: bold; font-size: 1.1rem; border: none; cursor: pointer; transition: transform 0.3s, box-shadow 0.3s; box-shadow: rgba(0, 220, 255, 0.5) 0px 0px 15px, rgba(150, 0, 255, 0.5) 0px 0px 15px; }

.cta-button:hover, .cta-button:focus { transform: translateY(-3px); box-shadow: rgba(0, 220, 255, 0.7) 0px 5px 25px, rgba(150, 0, 255, 0.7) 0px 5px 25px; }

.hero-viz { position: absolute; bottom: 0px; left: 50%; transform: translateX(-50%); width: 80%; max-width: 600px; height: 150px; opacity: 0.4; z-index: 1; }

.hero-viz svg { width: 100%; height: 100%; filter: url("#glow"); }

.hero-viz .node { fill: url("#grad1"); animation: 3s ease 0s infinite alternate none running pulse; }

.hero-viz .link { stroke: url("#grad1"); stroke-width: 1; opacity: 0.7; animation: 5s linear 0s infinite normal none running dash; }

@keyframes pulse { 
  0% { r: 4; opacity: 0.8; }
  100% { r: 6; opacity: 1; }
}

@keyframes dash { 
  100% { stroke-dashoffset: 100; }
}

.hero-viz .link { stroke-dasharray: 5; stroke-dashoffset: 0; }

.hero-viz .node:nth-child(2) { animation-delay: 0.2s; }

.hero-viz .node:nth-child(3) { animation-delay: 0.4s; }

.hero-viz .node:nth-child(4) { animation-delay: 0.6s; }

.hero-viz .node:nth-child(5) { animation-delay: 0.8s; }

.hero-viz .node:nth-child(6) { animation-delay: 1s; }

.hero-viz .node:nth-child(7) { animation-delay: 1.2s; }

.hero-viz .link:nth-of-type(2) { animation-delay: 0.1s; }

.hero-viz .link:nth-of-type(3) { animation-delay: 0.3s; }

.hero-viz .link:nth-of-type(4) { animation-delay: 0.5s; }

.hero-viz .link:nth-of-type(5) { animation-delay: 0.7s; }

.hero-viz .link:nth-of-type(6) { animation-delay: 0.9s; }

.hero-viz .link:nth-of-type(7) { animation-delay: 1.1s; }

.hero-viz .link:nth-of-type(8) { animation-delay: 1.3s; }

h2 { font-family: var(--font-heading); font-size: 2.5rem; color: var(--accent-color); text-align: center; margin-bottom: 3rem; text-shadow: 0 0 8px var(--primary-color); }

#about p { max-width: 800px; margin: 0px auto; text-align: center; font-size: 1.1rem; color: var(--text-darker); }

.service-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 3rem; }

.service-item { background-color: rgba(255, 255, 255, 0.05); padding: 2rem; border-radius: 8px; text-align: center; border: 1px solid rgba(0, 220, 255, 0.2); transition: transform 0.3s, box-shadow 0.3s; }

.service-item:hover { transform: translateY(-10px); box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2), 0 0 15px var(--secondary-color); }

.service-icon { font-size: 3rem; margin-bottom: 1rem; display: inline-block; filter: drop-shadow(0 0 5px var(--primary-color)); }

.service-item h3 { font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 1rem; color: var(--primary-color); }

.service-item p { font-size: 0.95rem; color: var(--text-darker); }

#contact p { text-align: center; margin-bottom: 2rem; max-width: 700px; margin-left: auto; margin-right: auto; color: var(--text-darker); }

#contact form { max-width: 600px; margin: 2rem auto 0px; display: flex; flex-direction: column; gap: 1rem; }

#contact input, #contact textarea { padding: 1rem; background-color: rgba(255, 255, 255, 0.08); border: 1px solid rgba(0, 220, 255, 0.3); border-radius: 5px; color: var(--text-color); font-family: var(--font-main); font-size: 1rem; transition: border-color 0.3s, box-shadow 0.3s; }

#contact input::placeholder, #contact textarea::placeholder { color: var(--text-darker); }

#contact input:focus, #contact textarea:focus { outline: none; border-color: var(--primary-color); box-shadow: rgba(0, 220, 255, 0.5) 0px 0px 10px; }

#contact textarea { min-height: 150px; resize: vertical; }

#contact button { align-self: center; }

footer { background-color: rgba(10, 10, 26, 0.9); text-align: center; padding: 1.5rem 0px; margin-top: 4rem; border-top: 1px solid rgba(0, 220, 255, 0.1); font-size: 0.9rem; color: var(--text-darker); }

@media (max-width: 768px) {
  header .container { flex-direction: column; align-items: center; }
  nav ul { margin-top: 1rem; padding: 0px; }
  nav ul li { margin: 0px 0.8rem; }
  main { padding-top: 120px; }
  #hero h1 { font-size: 2.8rem; min-height: 70px; }
  #hero p { font-size: 1rem; }
  h2 { font-size: 2rem; }
  .service-grid { grid-template-columns: 1fr; }
  .hero-viz { height: 100px; opacity: 0.3; }
}

@media (max-width: 480px) {
  #hero h1 { font-size: 2.2rem; min-height: 60px; }
  nav ul li a { font-size: 0.9rem; }
  nav ul li { margin: 0px 0.5rem; }
  .cta-button { padding: 10px 25px; font-size: 1rem; }
  section { padding: 4rem 0px; }
}

.ti-cursor { color: var(--primary-color); margin-left: 0.1em; animation: 0.7s ease 0s infinite normal none running blink; text-shadow: 0 0 5px var(--primary-color); }

@keyframes blink { 
  0% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 1; }
}
